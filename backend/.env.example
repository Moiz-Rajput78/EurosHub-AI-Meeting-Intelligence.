# ============================================================
# Meeting Intelligence - Backend Environment Configuration
# ============================================================


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

APP_NAME=Meeting Intelligence
APP_ENV=development
DEBUG=true

HOST=127.0.0.1
PORT=8000


# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

DATABASE_URL=sqlite:///./meetings.db


# ------------------------------------------------------------
# File Uploads
# ------------------------------------------------------------

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=500


# ------------------------------------------------------------
# Ollama Cloud
# ------------------------------------------------------------

# Ollama Cloud API base URL
OLLAMA_BASE_URL=https://ollama.com

# Ollama Cloud model used for structured meeting analysis
OLLAMA_MODEL=gemma4:cloud

# Create an Ollama API key and place the real value only
# inside backend/.env.
OLLAMA_API_KEY=your_ollama_api_key_here


# ------------------------------------------------------------
# Faster Whisper
# ------------------------------------------------------------

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8


# ------------------------------------------------------------
# Pyannote Speaker Diarization
# ------------------------------------------------------------

# Hugging Face token with access to the required gated
# pyannote speaker diarization model.
HUGGINGFACE_TOKEN=your_huggingface_token_here

PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
PYANNOTE_DEVICE=cpu


# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]